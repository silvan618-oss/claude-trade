# Alpaca (Paper Trading) — Keys unter https://app.alpaca.markets erstellen
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = Paper Trading (Spielgeld). Erst auf false stellen, wenn das
# Memory-System nachweislich greift — und dann nur mit 1-3 % des Kapitals.
ALPACA_PAPER=true

# Claude API — das "Gehirn" des Bots. Ohne Key läuft der Bot mit einem
# einfachen regelbasierten Fallback (kein LLM-Review).
ANTHROPIC_API_KEY=

# QuiverQuant — Pflichtmeldungen von Insidern (SEC Form 4) und
# Kongressmitgliedern (STOCK Act). Ohne Key laufen simulierte Meldungen.
QUIVER_API_KEY=

# Signalquelle: ma | insider | combined
SIGNAL_MODE=ma
# Cluster Buying: so viele *verschiedene* Insider muessen im Fenster kaufen
INSIDER_MIN_BUYERS=3
INSIDER_LOOKBACK_DAYS=30
# Meldungen mit groesserem Verzug zwischen Trade und Veroeffentlichung sind
# eingepreist und werden verworfen (Form 4 ~2 Tage, Kongress bis 45 Tage).
INSIDER_MAX_FILING_LAG_DAYS=21

# Handelsparameter
SYMBOLS=AAPL,MSFT,SPY
FAST_MA=9
SLOW_MA=21
RISK_PCT=2.0
LOOP_INTERVAL_SECONDS=300
