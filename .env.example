# Alpaca (Paper Trading) — Keys unter https://app.alpaca.markets erstellen
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = Paper Trading (Spielgeld). Erst auf false stellen, wenn das
# Memory-System nachweislich greift — und dann nur mit 1-3 % des Kapitals.
ALPACA_PAPER=true

# Claude API — das "Gehirn" des Bots. Ohne Key läuft der Bot mit einem
# einfachen regelbasierten Fallback (kein LLM-Review).
ANTHROPIC_API_KEY=

# Handelsparameter
SYMBOLS=AAPL,MSFT,SPY
FAST_MA=9
SLOW_MA=21
RISK_PCT=2.0
LOOP_INTERVAL_SECONDS=300

# Skew-Map (bot/skew_map.py) — die sieben Entscheidungen aus dem Skew-Kapitel.
# Alle optional; die Defaults stehen in SkewSettings (bot/skew.py).
# Einmal festlegen, aufschreiben — und nicht mitten in der Woche verschieben.

# #1 Delta, an dem Put und Call gespiegelt werden
SKEW_DELTA_TARGET=0.25
# #2 Ziel-Restlaufzeit und erlaubtes Fenster, monatliche Expiry bevorzugt
SKEW_TARGET_DTE=45
SKEW_MIN_DTE=25
SKEW_MAX_DTE=75
# #4 Sektor-Benchmark: weniger Namen = kein Sektor-Read; darunter Caveat
SKEW_MIN_SECTOR_NAMES=5
SKEW_MIN_AGREEMENT=0.6
# #5 dünne Kette = abgewertet, nicht gelöscht
SKEW_MIN_OI=100
# #6 darüber: kaputter Mark, nicht handeln
SKEW_SANITY_CEILING=0.75
# #7 datierte Snapshots — ohne die bleibt die Δ-Spalte leer
SKEW_HISTORY_DIR=skew_history
# Fadenkreuz der Karte: "zero" oder "median" der eigenen Liste
SKEW_CENTER_MODE=zero
