# Alpaca (Paper Trading) — Keys unter https://app.alpaca.markets erstellen
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = Paper Trading (Spielgeld). Erst auf false stellen, wenn das
# Memory-System nachweislich greift — und dann nur mit 1-3 % des Kapitals.
ALPACA_PAPER=true

# Claude API — das "Gehirn" des Bots. Ohne Key läuft der Bot mit einem
# einfachen regelbasierten Fallback (kein LLM-Review).
ANTHROPIC_API_KEY=

# Handelsparameter
SYMBOLS=AAPL,MSFT,SPY
FAST_MA=9
SLOW_MA=21
RISK_PCT=2.0
LOOP_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# TikTok-Videoproduktion (python -m tiktok --help)
# ---------------------------------------------------------------------------

# Kreativ-Gehirn: "cli" nutzt die Claude Code CLI und damit das eigene
# Abo-Kontingent (keine Zusatzkosten), "api" rechnet pro Token ab,
# "auto" nimmt die CLI, wenn sie installiert ist.
LLM_BACKEND=auto
CLAUDE_CLI=claude
MODEL_CREATIVE=claude-opus-5
MODEL_UTILITY=claude-haiku-4-5-20251001

# Video-Provider: "higgsfield" (HTTP-API), "higgsfield_cli" (offizielle CLI)
# oder "assisted" (Prompts raus, Clips selbst ablegen).
VIDEO_PROVIDER=assisted
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_CLI=higgsfield
VIDEO_MODEL=seedance-2.5
CLIP_SECONDS=10
POLL_INTERVAL_SECONDS=20
GENERATION_TIMEOUT_SECONDS=1800

# Stimme (Silver). Ohne Key wird das Video ohne Voiceover gebaut.
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Ausgabe und Schnitt
OUTPUT_DIR=output
CHANNELS_DIR=channels
TARGET_RESOLUTION=1080x1920
TARGET_FPS=30
BURN_SUBTITLES=false
AMBIENT_VOLUME=0.18
MUSIC_VOLUME=0.25

# Dauerbetrieb
LOOP_PAUSE_SECONDS=60
MAX_VIDEOS_PER_RUN=0
MAX_USD_PER_RUN=0
STOP_FILE=output/STOP
